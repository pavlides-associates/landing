---
const steps = [
  {
    n: "I",
    title: "Αποτύπωση και απαιτήσεις",
    body:
      "Οι πρώτες εβδομάδες αφιερώνονται σε συναντήσεις με τον πελάτη και επισκέψεις στον τόπο. Παράγονται αποτυπώσεις, μελέτες ηλιασμού και γραπτή σύνοψη απαιτήσεων που χρησιμεύουν ως βάση για όλες τις μετέπειτα αποφάσεις.",
  },
  {
    n: "II",
    title: "Παράλληλη μελέτη σε ενιαίο BIM",
    body:
      "Στατικά, ηλεκτρομηχανολογικά και κέλυφος μελετώνται παράλληλα από την πρώτη μέρα, σε ενιαίο BIM περιβάλλον (Maturity Level 3). Ο συντονισμός των μοντέλων γίνεται νωρίς, ώστε οι ασυμβατότητες να εντοπίζονται πριν από την κατασκευή.",
  },
  {
    n: "III",
    title: "Λεπτομέρεια στην πραγματική κλίμακα",
    body:
      "Οι ορατοί και προσβάσιμοι κόμβοι σχεδιάζονται σε κλίμακα 1:5 ή 1:1. Ο εργολάβος παραλαμβάνει τεύχη με πλήρη λεπτομέρεια, και το γραφείο βρίσκεται στο εργοτάξιο σε εβδομαδιαία βάση καθ’ όλη την κατασκευή.",
  },
  {
    n: "IV",
    title: "Αυτοματοποίηση τευχών και προμετρήσεων",
    body:
      "Το ιδιόκτητο σύστημα ταξινόμησης του γραφείου (PPER) ενσωματώνεται στο ArchiCAD και τροφοδοτεί τη βάση ποσοτήτων. Τιμολόγιο μελέτης, τεχνικές προδιαγραφές και τεύχη δημοπράτησης παράγονται αυτόματα από το μοντέλο.",
  },
];
---
<section id="methodology" class="methodology">
  <div class="container">
    <header class="m-header">
      <p class="eyebrow" data-reveal><span class="num">04</span> &nbsp; ΜΕΘΟΔΟΛΟΓΙΑ</p>
      <h2 data-reveal>Πώς δουλεύουμε.</h2>
    </header>

    <ol class="m-list" role="list">
      {steps.map((s) => (
        <li class="m-row" data-reveal>
          <span class="m-num" aria-hidden="true">{s.n}</span>
          <h3 class="m-title">{s.title}</h3>
          <p class="m-text">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .methodology {
    background: var(--paper);
    border-top: 1px solid var(--silver);
  }
  .m-header { margin-bottom: 56px; }
  .m-header h2 { max-width: 20ch; }

  .m-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .m-row {
    padding-block: 48px;
  }
  .m-row + .m-row {
    border-top: 1px solid var(--silver);
  }
  .m-row:first-child { padding-top: 0; }

  .m-num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 104px);
    font-variation-settings: "opsz" 144, "wght" 280, "SOFT" 60;
    line-height: 0.95;
    color: var(--silver);
    margin-bottom: 20px;
    letter-spacing: -0.01em;
  }
  .m-title {
    font-size: var(--fs-h2);
    margin: 0 0 12px;
    max-width: 28ch;
  }
  .m-text {
    margin: 0;
    color: var(--graphite);
    max-width: 64ch;
  }

  @media (min-width: 768px) {
    .m-row { padding-block: 64px; }
    .m-num { margin-bottom: 24px; }
    .m-title { margin-bottom: 16px; }
  }
</style>
