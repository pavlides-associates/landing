---
const steps = [
  {
    n: "I",
    title: "Πρώτα ακούμε, μετά μετράμε",
    body:
      "Οι πρώτες εβδομάδες περνούν με τον πελάτη και στον τόπο. Αποτυπώσεις, μελέτες ηλιασμού, γραπτή σύνοψη απαιτήσεων — αυτά είναι τα μοναδικά που επιβιώνουν από κάθε μετέπειτα απόφαση.",
  },
  {
    n: "II",
    title: "Σχεδιάζουμε με τους μηχανικούς στο ίδιο τραπέζι",
    body:
      "Στατικά, ηλεκτρομηχανολογικά και κέλυφος γεννιούνται παράλληλα από την πρώτη μέρα, σε ενιαίο BIM περιβάλλον (Maturity Level 3). Συντονίζουμε τα μοντέλα νωρίς, αντί να κυνηγάμε αργότερα τις συγκρούσεις — μία φορά, στην αρχή, αντί τρεις φορές, στο τέλος.",
  },
  {
    n: "III",
    title: "Λεπτομέρεια στην πραγματική κλίμακα",
    body:
      "Κάθε κόμβος που θα συναντήσει το μάτι και το χέρι σχεδιάζεται σε 1:5 ή 1:1. Ο εργολάβος παίρνει τεύχη που χτίζονται, όχι λίστες ευχών — και βρισκόμαστε στο εργοτάξιο εβδομαδιαίως καθ’ όλη την κατασκευή.",
  },
  {
    n: "IV",
    title: "Αυτοματοποίηση τευχών και προμετρήσεων",
    body:
      "Το ιδιόκτητο σύστημα ταξινόμησης του γραφείου (PPER) εμπλουτίζει το ArchiCAD και τροφοδοτεί τη βάση ποσοτήτων. Τιμολόγιο μελέτης, τεχνικές προδιαγραφές και τεύχη δημοπράτησης παράγονται αυτόματα — από εβδομάδες σε ώρες.",
  },
  {
    n: "V",
    title: "Παράδοση, και επιστροφή",
    body:
      "Μετά την παράδοση επισκεπτόμαστε το έργο στους έξι μήνες και στον έναν χρόνο — για να μάθουμε τι μας έμαθε το κτίριο και να διορθώσουμε ό,τι ζητάει διόρθωση όσο είναι ακόμη μικρό.",
  },
];
---
<section id="methodology" class="methodology">
  <div class="container">
    <header class="m-header">
      <p class="eyebrow" data-reveal><span class="num">04</span> &nbsp; ΜΕΘΟΔΟΛΟΓΙΑ</p>
      <h2 data-reveal>Πώς γεννιέται ένα κτίριο, εδώ.</h2>
    </header>

    <ol class="m-list" role="list">
      {steps.map((s) => (
        <li class="m-row" data-reveal>
          <span class="m-num" aria-hidden="true">{s.n}</span>
          <div class="m-body">
            <h3 class="m-title">{s.title}</h3>
            <p class="m-text">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .methodology {
    background: var(--paper);
    border-top: 1px solid var(--silver);
  }
  .m-header { margin-bottom: 56px; }
  .m-header h2 { max-width: 20ch; }

  .m-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--silver);
  }
  .m-row {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    padding: 32px 0;
    border-bottom: 1px solid var(--silver);
    align-items: baseline;
  }
  .m-num {
    font-family: var(--font-mono);
    font-size: var(--fs-h2);
    color: var(--concrete);
    letter-spacing: 0.04em;
  }
  .m-title {
    font-size: var(--fs-h2);
    margin: 0;
    max-width: 22ch;
  }
  .m-text {
    margin-top: 8px;
    color: var(--graphite);
    max-width: 64ch;
  }

  @media (min-width: 768px) {
    .m-row {
      grid-template-columns: 96px 6fr 6fr;
      column-gap: var(--col-gap);
      padding: 40px 0;
      align-items: start;
    }
    .m-text { margin-top: 0; }
  }
</style>
