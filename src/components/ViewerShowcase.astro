---
---
<section id="showcase" class="viewer-showcase" aria-labelledby="viewer-heading">
  <div class="container showcase-head">
    <p class="eyebrow" data-reveal><span class="num">01</span> &nbsp; ΣΥΝΑΡΜΟΓΗ ΜΟΝΤΕΛΩΝ — FEDERATED MODELS</p>
    <h2 id="viewer-heading" data-reveal>
      ΤΕΠ Ερυθρού Σταυρού
    </h2>
    <p class="lead" data-reveal>
      Στατικό, αρχιτεκτονικό και ηλεκτρομηχανολογικό — σχεδιασμένα μαζί, σε ένα ενιαίο BIM
      περιβάλλον.
    </p>
  </div>

  <div class="viewer-host" data-viewer-host>
    <div id="viewer"></div>

    <button id="sidebar-toggle" type="button" aria-label="Άνοιγμα/κλείσιμο πίνακα ειδικοτήτων" aria-expanded="false" aria-controls="sidebar">
      <svg class="icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="4" y1="7" x2="20" y2="7"/>
        <circle cx="9" cy="7" r="2.2" fill="currentColor"/>
        <line x1="4" y1="12" x2="20" y2="12"/>
        <circle cx="15" cy="12" r="2.2" fill="currentColor"/>
        <line x1="4" y1="17" x2="20" y2="17"/>
        <circle cx="11" cy="17" r="2.2" fill="currentColor"/>
      </svg>
      <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="18" y1="6" x2="6" y2="18"/>
      </svg>
    </button>

    <aside id="sidebar" aria-hidden="true">
      <h2>Ειδικότητες</h2>
      <div id="discipline-list"></div>
    </aside>

    <div id="loading">Φόρτωση μοντέλου…</div>
  </div>

  <div class="container showcase-foot">
    <p class="caption">Σύρετε για περιστροφή · ⌘/Ctrl + scroll ή pinch για zoom · Δύο δάχτυλα για μετακίνηση · Από το πλαϊνό μενού ρυθμίστε τη διαφάνεια ανά ειδικότητα</p>
  </div>
</section>

<script>
  // Lazy-load the viewer bundle only when the showcase enters the viewport.
  // Keeps ~6MB of TOC + three.js out of the critical path.
  const host = document.querySelector<HTMLElement>("[data-viewer-host]");
  if (host) {
    let started = false;
    const start = async () => {
      if (started) return;
      started = true;
      await import("../viewer/main.ts");
    };

    const supportsIO = typeof IntersectionObserver !== "undefined";
    if (supportsIO) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            void start();
          }
        },
        { rootMargin: "200px 0px" },
      );
      io.observe(host);
    } else {
      void start();
    }
  }
</script>

<style>
  .viewer-showcase {
    background: var(--shadow);
    color: var(--paper);
    /* Asymmetric: more breathing room on top so the section announces itself,
       less below so the viewer feels close to the next thing the eye lands on. */
    padding-top: clamp(120px, 14vw, 200px);
    padding-bottom: clamp(72px, 9vw, 120px);
    border-top: 1px solid var(--silver);
  }

  /* Head & foot are container-bounded; the viewer host itself is edge-to-edge. */
  .showcase-head {
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .showcase-head .eyebrow { color: #B0AAA0; }
  .showcase-head .eyebrow .num { color: var(--accent); margin-right: 6px; }
  .showcase-head h2 {
    color: var(--paper);
    /* Step up vs. other sections — this is the centerpiece. */
    font-size: clamp(40px, 7.5vw, 88px);
    line-height: 1.02;
    max-width: 22ch;
    font-variation-settings: "opsz" 144, "wght" 380, "SOFT" 50;
    letter-spacing: -0.012em;
  }
  .showcase-head .lead {
    color: #C9C4BC;
    margin-top: 28px;
    max-width: 52ch;
  }

  /* Edge-to-edge, taller. The viewer is the room — let it own the width. */
  .viewer-host {
    position: relative;
    width: 100%;
    height: clamp(640px, 82vh, 880px);
    overflow: hidden;
    background: var(--shadow-2);
    /* Hairline frames the canvas against the surrounding shadow. */
    border-block: 1px solid rgba(255, 255, 255, 0.06);
  }

  .showcase-foot {
    margin-top: 20px;
  }
  .caption {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #8E8A82;
    margin: 0;
  }

  /* On phones, give the viewer most of the screen — it's the experience. */
  @media (max-width: 600px) {
    .viewer-host {
      height: clamp(560px, 78vh, 760px);
    }
    .showcase-head h2 {
      font-size: clamp(36px, 11vw, 56px);
    }
  }
</style>
