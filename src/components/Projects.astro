---
import { projects } from "../data/projects";
---
<section id="projects" class="projects">
  <div class="container">
    <header class="projects-header">
      <p class="eyebrow" data-reveal><span class="num">03</span> &nbsp; ΕΠΙΛΕΓΜΕΝΑ ΕΡΓΑ</p>
      <h2 data-reveal>Πέντε κτίρια — εκπαίδευση, υγεία, κατοικία, αστικός χώρος.</h2>
    </header>

    <ol class="p-list" role="list">
      {projects.map((p) => (
        <li class="p-row" data-reveal>
          <a class="p-link" href={p.url} target="_blank" rel="noopener noreferrer">
            <span class="p-num" aria-hidden="true">{p.number}</span>
            <span class="p-cat">{p.category}</span>
            <span class="p-title">{p.title}</span>
            <span class="p-arrow" aria-hidden="true">↗</span>
            <span class="p-sr"> — ανοίγει σε νέα καρτέλα στο grafpa.gr</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="projects-foot" data-reveal>
      Πλήρες χαρτοφυλάκιο στο
      <a class="ext-link" href="https://grafpa.gr/" target="_blank" rel="noopener noreferrer">grafpa.gr</a>.
    </p>
  </div>
</section>

<style>
  .projects {
    background: var(--paper);
    border-top: 1px solid var(--silver);
  }
  .projects-header { margin-bottom: 56px; }
  .projects-header h2 { max-width: 22ch; }

  .p-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--silver);
  }
  .p-row { border-bottom: 1px solid var(--silver); }

  /* The whole row is the link. Grid on the link itself so click target is
     the full width and we don't need an inner wrapper. */
  .p-link {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    grid-template-areas:
      "num cat   arrow"
      "num title arrow";
    column-gap: 16px;
    row-gap: 4px;
    padding: 28px 0;
    color: var(--ink);
    transition: background var(--dur) var(--ease);
  }
  .p-link:hover { background: var(--bone); }

  /* Hairline accent that grows in from the left on hover — gives the row a
     deliberate "armed" state without a heavy background change. */
  .p-row { position: relative; }
  .p-row::before {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width var(--dur) var(--ease);
  }
  .p-row:hover::before { width: 100%; }
  .p-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .p-num {
    grid-area: num;
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--concrete);
    letter-spacing: 0.06em;
  }
  .p-cat {
    grid-area: cat;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--concrete);
  }
  .p-title {
    grid-area: title;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.6vw, 28px);
    line-height: 1.15;
    font-variation-settings: "opsz" 24, "wght" 420, "SOFT" 40;
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .p-arrow {
    grid-area: arrow;
    align-self: center;
    color: var(--silver);
    font-size: 1.1rem;
    line-height: 1;
    transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .p-link:hover .p-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  /* Screen-reader-only — announces the external-link affordance for AT users.
     Inline because the project doesn't have a global utility for this yet. */
  .p-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .projects-foot {
    margin-top: 32px;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--concrete);
  }
  .projects-foot .ext-link {
    color: var(--graphite);
    border-bottom: 1px solid transparent;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .projects-foot .ext-link:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  /* Desktop: split category and title into their own columns so each row
     reads as one horizontal line. The title takes the remaining space. */
  @media (min-width: 768px) {
    .p-link {
      grid-template-columns: 72px 200px 1fr auto;
      grid-template-areas: "num cat title arrow";
      column-gap: var(--col-gap);
      row-gap: 0;
      padding: 36px 0;
      align-items: baseline;
    }
    .p-cat, .p-title { align-self: baseline; }
    .p-arrow { align-self: baseline; }
  }
</style>
