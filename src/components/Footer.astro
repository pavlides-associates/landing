---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <p class="footer-line">
      © {year}
      <span class="sep" aria-hidden="true">·</span>
      Γραφείο Παυλίδη Α.Τ.Ε.Μ.
      <span class="sep" aria-hidden="true">·</span>
      <a href="https://grafpa.gr" target="_blank" rel="noopener noreferrer">grafpa.gr</a><span class="ext" aria-hidden="true">↗</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--paper);
    border-top: 1px solid var(--silver);
    padding-block: 40px;
  }
  .footer-line {
    margin: 0 auto;
    text-align: center;
    color: var(--concrete);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.6;
  }
  .footer-line .sep {
    margin: 0 10px;
    color: var(--silver);
  }
  .footer-line a {
    color: var(--graphite);
    border-bottom: 1px solid transparent;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
    /* Cancel the trailing letter-spacing so the (eventual) hover underline
       ends flush with the last glyph instead of overshooting by ~2px. */
    margin-inline-end: -0.14em;
  }
  .footer-line a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .footer-line .ext {
    /* Decorative external-link mark, sat outside the anchor so it doesn't
       inherit the underline or the trailing letter-spacing. */
    margin-inline-start: 0.4em;
    color: var(--silver);
    font-size: 0.85em;
  }
</style>
