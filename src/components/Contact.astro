---
const office = {
  street: "Ακταίου 40",
  city: "118 51 — Αθήνα",
  country: "Ελλάδα",
  phone: "210 92 27 708",
  phoneTel: "+302109227708",
  email: "info@grafpa.gr",
  website: "grafpa.gr",
  websiteUrl: "https://grafpa.gr",
  hours: "Δευτέρα – Παρασκευή, 09:00 – 18:00",
  mapsUrl: "https://www.google.com/maps/search/?api=1&query=Ακταίου+40,+Αθήνα",
};
---
<section id="contact" class="contact">
  <div class="container contact-grid">
    <div class="meta-col" data-reveal>
      <p class="eyebrow"><span class="num">05</span> &nbsp; ΕΠΙΚΟΙΝΩΝΙΑ</p>
    </div>

    <div class="body-col">
      <h2 data-reveal>Για νέες αναθέσεις και ήσυχες ερωτήσεις.</h2>

      <dl class="contact-list" data-reveal>
        <div class="contact-row">
          <dt>Γραφείο</dt>
          <dd>
            {office.street}<br />
            {office.city}<br />
            {office.country}
          </dd>
        </div>
        <div class="contact-row">
          <dt>Τηλέφωνο</dt>
          <dd><a href={`tel:${office.phoneTel}`}>{office.phone}</a></dd>
        </div>
        <div class="contact-row">
          <dt>Email</dt>
          <dd><a class="email" href={`mailto:${office.email}`}>{office.email}</a></dd>
        </div>
        <div class="contact-row">
          <dt>Ιστοσελίδα</dt>
          <dd><a href={office.websiteUrl} target="_blank" rel="noopener noreferrer">{office.website} ↗</a></dd>
        </div>
        <div class="contact-row">
          <dt>Ωράριο</dt>
          <dd>{office.hours}</dd>
        </div>
        <div class="contact-row">
          <dt>Χάρτης</dt>
          <dd>
            <a href={office.mapsUrl} target="_blank" rel="noopener noreferrer">Άνοιγμα στους Χάρτες Google ↗</a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--paper);
    border-top: 1px solid var(--silver);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .meta-col .eyebrow .num { color: var(--accent); margin-right: 6px; }
  .body-col h2 { max-width: 22ch; }

  .contact-list {
    margin: 32px 0 0;
    border-top: 1px solid var(--silver);
  }
  .contact-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
    padding: 20px 0;
    border-bottom: 1px solid var(--silver);
  }
  .contact-row dt {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--concrete);
  }
  .contact-row dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .contact-row a {
    border-bottom: 1px solid transparent;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .contact-row a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  /* The one place red appears outside the brand mark — only on hover. */
  .contact-row a.email:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 3fr 9fr;
      gap: var(--col-gap);
    }
    .contact-row {
      grid-template-columns: 4fr 8fr;
      column-gap: var(--col-gap);
      align-items: baseline;
    }
  }
</style>
